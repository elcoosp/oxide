examples/.v8-*/

# §22: cargo-fuzz build dir (each fuzz run rebuilds; never commit)
fuzz/target/

dump.txt
test-results/
tests/playwright/test-results/
oxide-launch-content
.DS_Store
crates/cli/.oxide/

# Build artifacts must never land in src/. tsgo, invoked transitively by
# a downstream tsdown package's dts step, reads the target package's
# tsconfig for compilation settings and emits declarations next to
# source if `declaration: true`. tsdown emits to dist/ on its own; the
# tsconfig flag is vestigial. Belt-and-braces so a stray can never
# re-enter the index even if a tool re-emits.
packages/*/src/**/*.d.ts
packages/*/src/**/*.d.ts.map
# Hand-written ambient declarations are NOT strays:
!packages/oxide-website/src/env.d.ts
.oxide-dev.log

# The @oxide-fw/cli postinstall downloads the prebuilt binary into this
# cache dir next to install.js. It is machine-local state, never source.
packages/cli-npm/.oxide-bin/

# commit.sh — the milestone's commit protocol script is machine-local
# tooling, not source (one conventional commit per file, never committed
# itself).
commit.sh

# dhat test artifact (written at profiler drop)
dhat-heap.json

# ship.sh — the milestone commit+release protocol (machine-local, like commit.sh)
ship.sh

# .github/pr-body.md - the milestone PR body (agent-written, consumed by
# ship.sh via gh pr create --body-file; machine-local like ship.sh)
.github/pr-body.md

# ship.toml — the declarative delivery manifest (branch, PR title/body and
# the [[commit]] file groups) consumed by the ship tooling; machine-local
# like ship.sh, and listed in its own [[commit]]-union rules.
ship.toml
