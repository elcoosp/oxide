{
  "name": "@oxide/svelte",
  "version": "0.1.0",
  "description": "Svelte adapter for Oxide: adapter manifest + render/hydrate over the neutral IR (spec \u00a77). Zero runtime dependencies; runs on Node 24 type stripping. Without the Svelte SSR runtime installed the adapter renders the neutral element-tree IR itself.",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./hydrate": "./src/hydrate.ts",
    "./ir": "./src/ir.ts",
    "./package.json": "./package.json",
    "./real-adapter": "./src/real-adapter.ts",
    "./render": "./src/render.ts",
    "./image": "./src/Image.svelte"
  },
  "scripts": {
    "test": "node --test test/*.test.ts"
  },
  "engines": {
    "node": ">=24"
  },
  "keywords": [
    "oxide",
    "svelte",
    "adapter",
    "ssr"
  ],
  "license": "MIT",
  "peerDependencies": {
    "svelte": "^5.0.0"
  },
  "peerDependenciesMeta": {
    "svelte": {
      "optional": true
    }
  },
  "devDependencies": {
    "svelte": "^5.0.0"
  },
  "sideEffects": false
}