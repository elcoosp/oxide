{
  "name": "oxide-og",
  "version": "0.1.0",
  "description": "OpenGraph image generator for the Oxide project \u2014 turns docs/logo.png and the React/Vue/Svelte/Solid icons into a sleek premium OG image for github.com/elcoosp/oxide",
  "type": "module",
  "license": "MIT",
  "bin": {
    "oxide-og": "./dist/cli.js"
  },
  "scripts": {
    "og": "tsx src/cli.ts",
    "build": "tsc -p tsconfig.json",
    "generate": "tsx src/cli.ts --input ./assets --out out"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "playwright": "^1.64.1"
  },
  "devDependencies": {
    "@types/node": "^24",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "private": true
}
