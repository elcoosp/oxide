{
  "name": "@oxide-fw/core",
  "version": "0.1.0",
  "description": "Oxide runtime package: server data APIs (\u00a79), ODF wire decoder (\u00a79.5/D11), core client router (\u00a78.4/D9), islands loader (\u00a710.3), test helper (\u00a716.6). Zero runtime dependencies; runs on Node 24 type stripping.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
