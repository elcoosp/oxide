      "default": "./dist/server-real-ssr.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "default": "./dist/client.js"
    },
    "./client/boot": {
      "types": "./dist/client-boot.d.ts",
      "default": "./dist/client-boot.js"
    },
    "./client/defer-glue": {
      "types": "./dist/client-defer-glue.d.ts",
      "default": "./dist/client-defer-glue.js"
    },
    "./client/enhance": {
      "types": "./dist/client-enhance.d.ts",
