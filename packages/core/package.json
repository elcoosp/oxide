{
  "name": "@oxide-fw/core",
  "version": "0.1.0",
  "description": "Framework-agnostic runtime primitives for Oxide: routing types, ODF encoding, islands and hydration helpers.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "default": "./dist/server.js"
    },
    "./server/boundary": {
      "types": "./dist/server-boundary.d.ts",
      "default": "./dist/server-boundary.js"
    },
    "./server/deferred": {
      "types": "./dist/server-deferred.d.ts",
      "default": "./dist/server-deferred.js"
    },
    "./server/real-ssr": {
      "types": "./dist/server-real-ssr.d.ts",
      "default": "./dist/server-real-ssr.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "default": "./dist/client.js"
    },
    "./client/boot": {
      "types": "./dist/client-boot.d.ts",
      "default": "./dist/client-boot.js"
    },
    "./client/defer-glue": {
      "types": "./dist/client-defer-glue.d.ts",
      "default": "./dist/client-defer-glue.js"
    },
    "./client/enhance": {
      "types": "./dist/client-enhance.d.ts",
      "default": "./dist/client-enhance.js"
    },
    "./client/islands": {
      "types": "./dist/client-islands.d.ts",
      "default": "./dist/client-islands.js"
    },
    "./client/messages": {
      "types": "./dist/client-messages.d.ts",
      "default": "./dist/client-messages.js"
    },
    "./client/route-manifest": {
      "types": "./dist/client-route-manifest.d.ts",
      "default": "./dist/client-route-manifest.js"
    },
    "./client/router": {
      "types": "./dist/client-router.d.ts",
      "default": "./dist/client-router.js"
    },
    "./bytes": {
      "types": "./dist/bytes.d.ts",
      "default": "./dist/bytes.js"
    },
    "./fn": {
      "types": "./dist/fn.d.ts",
      "default": "./dist/fn.js"
    },
    "./image-sizes": {
      "types": "./dist/image-sizes.d.ts",
      "default": "./dist/image-sizes.js"
    },
    "./odf-encode": {
      "types": "./dist/odf-encode.d.ts",
      "default": "./dist/odf-encode.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "default": "./dist/types.js"
    },
    "./test": {
      "types": "./dist/test.d.ts",
      "default": "./dist/test.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "postbuild": "node ../../scripts/clean-stray-dts.mjs",
    "build": "tsdown",
    "dev": "tsdown --watch",
    "prepublishOnly": "pnpm build",
    "test": "node --test test/*.test.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "engines": {
    "node": ">=24"
  },
  "keywords": [
    "oxide",
    "web-framework",
    "ssr",
    "islands",
    "hydration"
  ],
  "license": "MIT",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md"
  ],
  "types": "./dist/index.d.ts",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "devDependencies": {
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "tsdown": "^0.23.3",
    "typescript": "^7.0.2"
  },
  "publishConfig": {},
  "repository": {
    "type": "git",
    "url": "git+https://github.com/elcoosp/oxide.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/elcoosp/oxide/tree/main/packages/core#readme",
  "bugs": {
    "url": "https://github.com/elcoosp/oxide/issues"
  },
  "author": "elcoosp <elcoosp@gmail.com>"
}
