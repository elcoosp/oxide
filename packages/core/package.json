    },
    "./client/router": {
      "types": "./dist/client-router.d.ts",
      "default": "./dist/client-router.js"
    },
    "./bytes": {
      "types": "./dist/bytes.d.ts",
      "default": "./dist/bytes.js"
    },
    "./fn": {
      "types": "./dist/fn.d.ts",
      "default": "./dist/fn.js"
