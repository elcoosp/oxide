{
  "name": "@oxide-fw/core",
  "version": "0.1.0",
  "description": "Oxide runtime package: server data APIs (\u00a79), ODF wire decoder (\u00a79.5/D11), core client router (\u00a78.4/D9), islands loader (\u00a710.3), test helper (\u00a716.6). Zero runtime dependencies; runs on Node 24 type stripping.",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./server": "./src/server/index.ts",
    "./server/boundary": "./src/server/boundary.ts",
    "./server/deferred": "./src/server/deferred.ts",
    "./server/real-ssr": "./src/server/real-ssr.ts",
    "./client": "./src/client/index.ts",
    "./client/boot": "./src/client/boot.ts",
    "./client/defer-glue": "./src/client/defer-glue.ts",
    "./client/enhance": "./src/client/enhance.ts",
    "./client/islands": "./src/client/islands.ts",
    "./client/messages": "./src/client/messages.ts",
    "./client/route-manifest": "./src/client/route-manifest.ts",
    "./client/router": "./src/client/router.ts",
    "./bytes": "./src/bytes.ts",
    "./fn": "./src/fn.ts",
    "./image-sizes": "./src/image-sizes.ts",
    "./odf-encode": "./src/odf-encode.ts",
    "./types": "./src/types.ts",
    "./test": "./src/test.ts",
    "./test/helpers/odf-lite": "./test/helpers/odf-lite.ts",
    "./package.json": "./package.json"
  },
  "scripts": {
    "test": "node --test test/*.test.ts",
