{
  "name": "create-oxide",
  "version": "0.1.0",
  "description": "Scaffold a new Oxide project with `pnpm create oxide`.",
  "type": "module",
  "main": "./dist/index.js",
  "bin": {
    "create-oxide": "./dist/index.js"
  },
  "scripts": {
    "postbuild": "node ../../scripts/clean-stray-dts.mjs",
    "build": "tsdown",
    "dev": "tsdown --watch",
    "prepublishOnly": "pnpm build",
    "test": "node --test test/*.test.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "engines": {
    "node": ">=24"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/elcoosp/oxide.git",
    "directory": "packages/create-oxide"
  },
  "license": "MIT",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "types": "./dist/index.d.ts",
  "module": "./dist/index.js",
  "devDependencies": {
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "tsdown": "^0.23.3",
    "typescript": "^7.0.2"
  },
  "publishConfig": {},
  "keywords": [
    "oxide",
    "create",
    "scaffold",
    "starter",
    "web-framework"
  ],
  "homepage": "https://github.com/elcoosp/oxide/tree/main/packages/create-oxide#readme",
  "bugs": {
    "url": "https://github.com/elcoosp/oxide/issues"
  },
  "author": "elcoosp <elcoosp@gmail.com>"
}
