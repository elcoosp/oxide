{
  "name": "@oxide-fw/tailwind",
  "version": "0.1.0",
  "description": "Tailwind CSS integration for Oxide: content scanning and build-time extraction.",
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./runtime.mjs": "./runtime.mjs",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "runtime.mjs"
  ],
  "dependencies": {
    "@tailwindcss/oxide": "^4.3.3",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@types/node": "^24",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "tsdown": "^0.23.3",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=24"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/elcoosp/oxide.git",
    "directory": "packages/tailwind"
  },
  "scripts": {
    "postbuild": "node ../../scripts/clean-stray-dts.mjs",
    "build": "tsdown",
    "dev": "tsdown --watch",
    "prepublishOnly": "pnpm build",
    "test": "node ../../scripts/test-tailwind-runtime.mjs"
  },
  "sideEffects": false,
  "types": "./dist/index.d.ts",
  "module": "./dist/index.js",
  "publishConfig": {},
  "keywords": [
    "oxide",
    "tailwind",
    "tailwindcss",
    "css",
    "web-framework"
  ],
  "homepage": "https://github.com/elcoosp/oxide/tree/main/packages/tailwind#readme",
  "bugs": {
    "url": "https://github.com/elcoosp/oxide/issues"
  },
  "author": "elcoosp <elcoosp@gmail.com>"
}
