{
  "name": "@oxide-fw/tailwind",
  "version": "0.1.0",
  "description": "Tailwind v4 native plugin for Oxide. Uses @tailwindcss/oxide (Rust scanner) and tailwindcss (CSS compiler) directly via Oxide's tooling pool \u2014 zero PostCSS, zero subprocess.",
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./runtime.mjs": "./runtime.mjs",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "runtime.mjs"
  ],
  "dependencies": {
    "@tailwindcss/oxide": "^4.3.3",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@types/node": "^24",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "tsdown": "^0.23.3",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=24"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/elcoosp/oxide.git"
  },
  "scripts": {
    "postbuild": "node ../../scripts/clean-stray-dts.mjs",
    "build": "tsdown",
    "dev": "tsdown --watch",
    "prepublishOnly": "pnpm build",
    "test": "node ../../scripts/test-tailwind-runtime.mjs"
  },
  "sideEffects": false,
  "types": "./dist/index.d.ts",
  "module": "./dist/index.js",
  "publishConfig": {}
}
