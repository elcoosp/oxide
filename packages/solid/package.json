{
  "name": "@oxide/solid",
  "version": "0.1.0",
  "description": "Solid adapter for Oxide: adapter manifest + render/hydrate over the neutral IR (spec \u00a77). Zero runtime dependencies; runs on Node 24 type stripping. Without @solidjs/web installed the adapter renders the neutral element-tree IR itself.",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./hydrate": "./src/hydrate.ts",
    "./ir": "./src/ir.ts",
    "./package.json": "./package.json",
    "./real-adapter": "./src/real-adapter.ts",
    "./render": "./src/render.ts",
    "./image": "./src/image.ts"
  },
  "scripts": {
    "test": "node --test test/*.test.ts"
  },
  "engines": {
    "node": ">=24"
  },
  "keywords": [
    "oxide",
    "solid",
    "adapter",
    "ssr"
  ],
  "license": "MIT",
  "peerDependencies": {
    "solid-js": "^2.0.0-rc.14",
    "@solidjs/web": "^2.0.0-rc.14"
  },
  "peerDependenciesMeta": {
    "solid-js": {
      "optional": true
    },
    "@solidjs/web": {
      "optional": true
    }
  },
  "devDependencies": {
    "solid-js": "^2.0.0-rc.14",
    "@solidjs/web": "^2.0.0-rc.14"
  },
  "sideEffects": false
}