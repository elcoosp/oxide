{
  "name": "@oxide/solid",
  "version": "0.1.0",
  "description": "Solid adapter for Oxide: adapter manifest + render/hydrate over the neutral IR (spec \u00a77). Zero runtime dependencies; runs on Node 24 type stripping. Without solid-js/web installed the adapter renders the neutral element-tree IR itself.",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./ir": "./src/ir.ts",
    "./render": "./src/render.ts",
    "./hydrate": "./src/hydrate.ts",
    "./package.json": "./package.json"
  },
  "scripts": {
    "test": "node --test test/*.test.ts"
  },
  "engines": {
    "node": ">=24"
  },
  "keywords": [
    "oxide",
    "solid",
    "adapter",
    "ssr"
  ],
  "license": "MIT",
  "peerDependencies": {
    "solid-js": "^1.9.0"
  },
  "peerDependenciesMeta": {
    "solid-js": {
      "optional": true
    }
  },
  "devDependencies": {
    "solid-js": "^1.9.0"
  }
}
