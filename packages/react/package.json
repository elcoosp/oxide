{
  "name": "@oxide/react",
  "version": "0.1.0",
  "description": "React adapter for Oxide: manifest + render/hydrate per spec \u00a77. Zero runtime dependencies; runs on Node 24 type stripping. Without framework deps installed the adapter renders the neutral element-tree IR itself (the real react-dom/server replaces the renderer when deps exist).",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./hydrate": "./src/hydrate.ts",
    "./ir": "./src/ir.ts",
    "./package.json": "./package.json",
    "./real-adapter": "./src/real-adapter.ts",
    "./render": "./src/render.ts",
    "./image": "./src/image.ts"
  },
  "scripts": {
    "test": "node --test test/*.test.ts"
  },
  "engines": {
    "node": ">=24"
  },
  "keywords": [
    "oxide",
    "react",
    "adapter",
    "ssr"
  ],
  "license": "MIT",
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0"
  },
  "sideEffects": false
}