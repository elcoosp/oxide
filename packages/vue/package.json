{
  "name": "@oxide/vue",
  "version": "0.1.0",
  "description": "Vue adapter for Oxide: adapter manifest + render/hydrate over the neutral IR (spec \u00a77). Zero runtime dependencies; runs on Node 24 type stripping. Without @vue/server-renderer installed the adapter renders the neutral element-tree IR itself.",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./hydrate": "./src/hydrate.ts",
    "./ir": "./src/ir.ts",
    "./package.json": "./package.json",
    "./real-adapter": "./src/real-adapter.ts",
    "./render": "./src/render.ts"
  },
  "scripts": {
    "test": "node --test test/*.test.ts"
  },
  "engines": {
    "node": ">=24"
  },
  "keywords": [
    "oxide",
    "vue",
    "adapter",
    "ssr"
  ],
  "license": "MIT",
  "peerDependencies": {
    "vue": "^3.6.0-rc.11",
    "@vue/server-renderer": "^3.6.0-rc.11"
  },
  "peerDependenciesMeta": {
    "vue": {
      "optional": true
    },
    "@vue/server-renderer": {
      "optional": true
    }
  },
  "devDependencies": {
    "vue": "^3.6.0-rc.11",
    "@vue/server-renderer": "^3.6.0-rc.11"
  },
  "sideEffects": false
}
