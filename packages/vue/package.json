{
  "name": "@oxide-fw/vue",
  "version": "0.1.0",
  "description": "Vue adapter for Oxide: adapter manifest + render/hydrate over the neutral IR (spec §7). Zero runtime dependencies; runs on Node 24 type stripping. Without @vue/server-renderer installed the adapter renders the neutral element-tree IR itself.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./hydrate": {
      "types": "./dist/hydrate.d.ts",
      "default": "./dist/hydrate.js"
    },
    "./ir": {
      "types": "./dist/ir.d.ts",
      "default": "./dist/ir.js"
    },
    "./package.json": "./package.json",
    "./real-adapter": {
      "types": "./dist/real-adapter.d.ts",
      "default": "./dist/real-adapter.js"
    },
    "./render": {
      "types": "./dist/render.d.ts",
      "default": "./dist/render.js"
    },
    "./image": {
      "types": "./dist/image.d.ts",
      "default": "./dist/image.js"
    },
    "./defer": {
      "types": "./dist/defer.d.ts",
      "default": "./dist/defer.js"
    }
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "prepublishOnly": "pnpm build",
    "test": "node --test test/*.test.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "engines": {
    "node": ">=24"
  },
  "keywords": [
    "oxide",
    "vue",
    "adapter",
    "ssr"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@vue/server-renderer": "^3.6.0-rc.11",
    "vue": "^3.6.0-rc.11"
  },
  "peerDependenciesMeta": {
    "vue": {
      "optional": true
    },
    "@vue/server-renderer": {
      "optional": true
    }
  },
  "devDependencies": {
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "@vue/server-renderer": "^3.6.0-rc.11",
    "tsdown": "^0.23.3",
    "typescript": "^7.0.2",
    "vue": "^3.6.0-rc.11"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "README.md"
  ],
  "dependencies": {
    "@oxide-fw/core": "workspace:*"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/elcoosp/oxide.git",
    "directory": "packages/vue"
  },
  "publishConfig": {
    "access": "public"
  },
  "types": "./dist/index.d.ts",
  "main": "./dist/index.js",
  "module": "./dist/index.js"
}
