---
source: crates/adapters/tests/snapshots_adapters.rs
expression: dockerfile(false)
---
# syntax=docker/dockerfile:1
# Oxide docker target (§18) — distroless, non-root, healthcheck,
# reproducible layers. Generated by oxide-adapters; do not edit.

FROM rust:1 AS build
WORKDIR /src
COPY . .
RUN cargo build --release -p oxide-server
RUN strip target/release/server 2>/dev/null || true

FROM gcr.io/distroless/cc-debian12
WORKDIR /app
COPY --from=build /src/target/release/server /app/server
USER nonroot:nonroot
ENV PORT=3000
EXPOSE 3000
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s CMD ["/app/server", "health"]
ENTRYPOINT ["/app/server"]
