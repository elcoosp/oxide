## glue + budget (functional payload, ≤ 400 KB gzip)

$ wasm-bindgen target/wasm32-unknown-unknown/release/oxide_fw_core_wasm.wasm \
    --target web --out-name edge --out-dir crates/cli/resources
$ wasm-opt -Oz crates/cli/resources/edge_bg.wasm -o crates/cli/resources/edge_bg.wasm
$ mv crates/cli/resources/edge_bg.wasm crates/cli/resources/edge.wasm
$ grep -oE "export function [a-zA-Z0-9_]+" crates/cli/resources/edge.js
