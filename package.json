{
  "name": "oxide-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "Oxide monorepo: Rust workspace + TS packages (adapters, runtime, conformance).",
  "type": "module",
  "scripts": {
    "build": "pnpm -r run build",
    "build:packages": "pnpm -r --filter \"./packages/*\" run build",
    "check:rust": "cargo check --workspace",
    "test": "pnpm run test:rust && pnpm run test:packages",
    "test:conformance": "node --test conformance/test/*.test.ts",
    "test:create-oxide": "node --test packages/create-oxide/test/*.test.ts",
    "test:fixtures": "./tests/fixtures/check.sh",
    "test:framework-adapter": "cargo test -p oxide-jshost --test framework_host_e2e -- --ignored && cargo test -p oxide-jshost --test loader_host_e2e -- --ignored && cargo test -p oxide-jshost --test hmr_e2e -- --ignored && pnpm run test:smoke && pnpm run test:fixtures",
    "test:oxide": "node --test packages/core/test/*.test.ts",
    "test:packages": "node --test packages/*/test/*.test.ts conformance/test/*.test.ts",
    "test:playwright": "pnpm --filter @oxide/playwright test",
    "test:playwright:install": "pnpm --filter @oxide/playwright install-browsers",
    "test:react": "node --test packages/react/test/*.test.ts",
    "test:rust": "cargo test --workspace",
    "test:smoke": "cargo test -p oxide-fw-cli --lib -- --ignored smoke_app_renders smoke_app_builds dev_server_serves_smoke start_serves_smoke cli_render_dispatches_real_react_ssr",
    "test:solid": "node --test packages/solid/test/*.test.ts",
    "test:svelte": "node --test packages/svelte/test/*.test.ts",
    "test:vue": "node --test packages/vue/test/*.test.ts",
    "typecheck": "pnpm -r --workspace-concurrency=1 run typecheck"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@mdx-js/mdx": "^3.1.1",
    "@mdx-js/react": "^3.1.1",
    "@oxide-fw/tailwind": "workspace:*",
    "solid-jsx-oxc": "0.1.0-alpha.1"
  },
  "devDependencies": {
    "@types/node": "^24",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "@vue/compiler-sfc": "^3.5.44",
    "publint": "^0.3.25",
    "rolldown-plugin-dts": "^0.28.8",
    "sucrase": "^3.35.1",
    "svelte": "^5.57.3",
    "tsdown": "^0.23.3",
    "typescript": "7.1.0-beta"
  }
}
